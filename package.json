{
  "name": "banking-qe-framework",
  "version": "0.3.0",
  "description": "Playwright + TypeScript test automation framework for a demo banking app (ParaBank)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:hybrid": "playwright test tests/hybrid",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "analyze": "node tools/analyze-failures.mjs",
    "analyze:sample": "node tools/analyze-failures.mjs --file tools/sample-results.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
